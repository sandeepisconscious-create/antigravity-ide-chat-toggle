{
  "name": "antigravity-chat-toggle",
  "displayName": "Antigravity Chat Toggle",
  "description": "One-click button and shortcut to toggle the Antigravity Chat / Panel between full screen and split view.",
  "version": "1.0.1",
  "publisher": "sandheeprao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandheeprao/antigravity-chat-toggle"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "antigravity",
    "chat",
    "panel",
    "sidebar",
    "maximize",
    "split view",
    "full screen",
    "ai"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity-chat-toggle.toggle",
        "title": "Toggle Full Chat / Split View",
        "category": "Antigravity Chat",
        "icon": "$(screen-full)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "antigravity-chat-toggle.toggle",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "antigravity-chat-toggle.toggle",
        "key": "cmd+shift+m",
        "mac": "cmd+shift+m",
        "win": "ctrl+shift+m",
        "linux": "ctrl+shift+m"
      }
    ]
  }
}
